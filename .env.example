# Chạy local: dữ liệu nằm trong .data (không commit).
CREVID_DATA_DIR=.data
# Chrome có thể dùng trên macOS; bỏ trống để Remotion tải browser phù hợp.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Giọng Ngọc Huyền: thông tin từ tài khoản Vbee, không đưa vào trình duyệt.
VBEE_APP_ID=
VBEE_TOKEN=
VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Tùy chọn binary có sẵn; mặc định dùng npm ffmpeg-static/ffprobe-static.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Social publishing (server only; never use NEXT_PUBLIC_ for secrets)
SOCIAL_ORIGIN=http://127.0.0.1:3000
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Copy the supported version selected in your Meta app dashboard, e.g. vN.0
FACEBOOK_GRAPH_VERSION=
# X OAuth 2.0 confidential Web App credentials, not the app-only Bearer token
X_CLIENT_ID=
X_CLIENT_SECRET=
