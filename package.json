{
  "name": "cre-vid",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev --hostname 127.0.0.1\" \"tsx watch --env-file-if-exists=.env.local src/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start --hostname 127.0.0.1\" \"tsx --env-file-if-exists=.env.local src/worker.ts\"",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "benchmark": "tsx --env-file-if-exists=.env.local scripts/benchmark.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@mozilla/readability": "0.6.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "linkedom": "0.18.13",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "type": "module"
}
